//@version=6
// SPY 0DTE ORB + Compression — نسخة Pine من spy0dte/spy_orb_0dte.py (شارت SPY 5 دقائق، جلسة عادية)
//   ١) نطاق الافتتاح = قمة/قاع أول 15 دقيقة (9:30–9:45 نيويورك)
//   ٢) اليوم مؤهل فقط إذا النطاق (% من الافتتاح) < 0.8 × متوسطه لآخر 20 يوماً
//   ٣) أول إغلاق 5د فوق النطاق = Call ATM، تحته = Put ATM (شمعة الإشارة حتى 12:00 نيويورك)
//   ٤) وقف −35% من سعر العقد، بلا هدف، خروج 13:00 نيويورك. صفقة واحدة يومياً.
indicator("SPY 0DTE ORB + Compression", overlay = true, max_labels_count = 300)

ratioMax = input.float(0.8, "حد الضغط (نسبة النطاق للمتوسط)")
lookback = input.int(20, "أيام المتوسط")
stopPct  = input.float(35, "وقف العقد %")
lastSig  = input.int(1200, "آخر وقت للإشارة (HHMM نيويورك)")
exitAt   = input.int(1300, "وقت الخروج (HHMM نيويورك)")

tz  = "America/New_York"
hm  = hour(time, tz) * 100 + minute(time, tz)
day = year(time, tz) * 10000 + month(time, tz) * 100 + dayofmonth(time, tz)
inRth = hm >= 930 and hm < 1600
inOr  = hm >= 930 and hm < 945

var ranges   = array.new_float()
var int   curDay   = na
var int   dayBars  = 0
var int   orBars   = 0
var float orHi     = na
var float orLo     = na
var float orOpen   = na
var bool  decided  = false
var bool  qualified = false
var int   dir      = 0
var float ratio    = na

// يوم جديد — نحفظ نطاق اليوم السابق إن كان يوماً كاملاً (≥ 70 شمعة، مثل السكانر)
if inRth and (na(curDay) or day != curDay)
    if not na(curDay) and dayBars >= 70 and orBars >= 3
        ranges.push((orHi - orLo) / orOpen)
        if ranges.size() > 200
            ranges.shift()
    curDay    := day
    dayBars   := 0
    orBars    := 0
    orHi      := na
    orLo      := na
    orOpen    := na
    decided   := false
    qualified := false
    dir       := 0
    ratio     := na

if inRth
    dayBars += 1

if inOr
    orOpen := na(orOpen) ? open : orOpen
    orHi   := na(orHi) ? high : math.max(orHi, high)
    orLo   := na(orLo) ? low  : math.min(orLo, low)
    orBars += 1

// 9:45 — هل اليوم مؤهل؟
justDecided = false
if inRth and hm >= 945 and not decided and orBars >= 3
    decided := true
    justDecided := true
    n = math.min(lookback, ranges.size())
    if n > 0
        avg = ranges.slice(ranges.size() - n, ranges.size()).avg()
        ratio := ((orHi - orLo) / orOpen) / avg
        qualified := ratio < ratioMax

// الاختراق — أول إغلاق 5د خارج النطاق
signal = 0
if barstate.isconfirmed and qualified and dir == 0 and hm >= 945 and hm <= lastSig
    if close > orHi
        signal := 1
    else if close < orLo
        signal := -1
    dir := signal

exitBar = dir != 0 and hm == exitAt

// ------------------------------------------------------------------
// الرسم والتنبيهات
// ------------------------------------------------------------------
showOr = decided and inRth
plot(showOr ? orHi : na, "قمة النطاق", qualified ? color.lime : color.gray, 2, plot.style_linebr)
plot(showOr ? orLo : na, "قاع النطاق", qualified ? color.red  : color.gray, 2, plot.style_linebr)
bgcolor(inOr ? color.new(color.blue, 90) : na, title = "نافذة الافتتاح")

if justDecided and not na(ratio)
    label.new(bar_index, orHi, (qualified ? "مؤهل " : "غير مؤهل ") + str.tostring(ratio, "#.##") + "×",
         style = label.style_label_down, color = qualified ? color.green : color.gray, textcolor = color.white, size = size.tiny)

if signal != 0
    k = math.round(close)
    txt = (signal == 1 ? "CALL " : "PUT ") + str.tostring(k) + " 0DTE\nوقف العقد −" + str.tostring(stopPct) + "%\nخروج " + str.tostring(exitAt)
    label.new(bar_index, signal == 1 ? low : high, txt,
         style = signal == 1 ? label.style_label_up : label.style_label_down,
         color = signal == 1 ? color.green : color.red, textcolor = color.white, size = size.small)
    alert("SPY 0DTE " + (signal == 1 ? "CALL " : "PUT ") + str.tostring(k) + " — إغلاق " + str.tostring(close, "#.##") +
         " خارج النطاق " + str.tostring(orLo, "#.##") + " / " + str.tostring(orHi, "#.##"), alert.freq_once_per_bar_close)

if exitBar
    label.new(bar_index, high, "وقت الخروج", style = label.style_label_down, color = color.orange, textcolor = color.black, size = size.tiny)
    alert("SPY 0DTE — وقت الخروج، أغلق الصفقة إن كانت مفتوحة", alert.freq_once_per_bar)

alertcondition(signal == 1,  "ORB Call", "SPY 0DTE CALL — إغلاق فوق نطاق الافتتاح")
alertcondition(signal == -1, "ORB Put",  "SPY 0DTE PUT — إغلاق تحت نطاق الافتتاح")
alertcondition(justDecided and qualified, "ORB يوم مؤهل", "SPY 0DTE — اليوم مؤهل")
